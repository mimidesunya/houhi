{
  "name": "houhi",
  "version": "1.0.0",
  "description": "Court document generation system",
  "main": "dist/src/gui/main.js",
  "scripts": {
    "build": "node scripts/clean_dist.js && tsc -p . && copyfiles -u 1 \"src/**/*.html\" \"src/**/*.css\" \"src/**/*.md\" dist/src",
    "build:launcher": "dotnet publish platforms/windows/launcher/Launcher.csproj -c Release -p:PublishDir=../../../bin/",
    "ensure:native": "node scripts/ensure_native_modules.js",
    "gui": "npm run ensure:native && npm run build && electron dist/src/gui/main.js",
    "setup": "npm run build && node dist/setup.js",
    "test": "npm run ensure:native && npm run build && node --test tests",
    "docs:tools": "node scripts/generate_tool_docs.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "adm-zip": "^0.5.16",
    "canvas": "^2.11.2",
    "clipboardy": "^2.3.0",
    "copper-cti": "github:zamasoftnet/cti.nodejs",
    "imapflow": "^1.2.11",
    "nodemailer": "^8.0.1",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "copyfiles": "^2.4.1",
    "electron": "^40.0.0",
    "typescript": "^5.8.2"
  }
}
